{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mei-chan-nel.com/info1-quiz-app/data/questions/question.schema.json",
  "title": "情報Ⅰ知識問題",
  "type": "object",
  "required": [
    "id",
    "stem",
    "choices",
    "answer_choice_id",
    "explanation",
    "tags",
    "primary_terms",
    "source_display",
    "field_ids"
  ],
  "not": {
    "description": "廃止済みの用語名配列は問題データへ含めない。",
    "required": ["primary_term_names"]
  },
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "stem": { "type": "string", "minLength": 1 },
    "choices": { "type": "array", "minItems": 2 },
    "answer_choice_id": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "primary_terms": {
      "description": "問題に対応する正規の用語データ。用語名は各要素のtermを使用する。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "term_id",
          "term",
          "category",
          "code",
          "matched_variant"
        ],
        "properties": {
          "term_id": { "type": "string", "minLength": 1 },
          "term": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "code": { "type": "string", "minLength": 1 },
          "matched_variant": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "source_display": { "type": "string", "minLength": 1 },
    "field_ids": {
      "description": "主分野。必ず1分野だけを指定する。",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "society_security",
          "digital",
          "network",
          "data_db",
          "algorithm",
          "design"
        ]
      }
    }
  }
}
